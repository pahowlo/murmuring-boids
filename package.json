{
  "name": "murmuring-boids",
  "version": "0.8.4",
  "author": "pahowlo <paul.legoux@gmail.com>",
  "description": "A JS component for rendering an interactive murmuring boids animation.",
  "type": "module",
  "main": "./src/main.ts",
  "exports": "./src/main.ts",
  "dependencies": {
    "gl-matrix": "3.4.3"
  },
  "scripts": {
    "clean": "bun run install:clean build:clean test:clean",
    "install:clean": "rm -rf node_modules/",
    "bundle": "./.scripts/bundle.ts",
    "bundle:clean": "rm -rf dist/ target/",
    "demo": "vite",
    "format": "prettier --config package.json --write 'src/**/*.{js,ts,json}'",
    "check": "tsc --noEmit",
    "test:browser": "bun playwright install chromium; vitest run --browser.name=chromium --browser.headless",
    "test:clean": "bun playwright uninstall"
  },
  "prettier": {
    "printWidth": 100,
    "semi": false,
    "singleQuote": false
  },
  "devDependencies": {
    "@rollup/rollup-darwin-arm64": "4.53.1",
    "@types/bun": "1.3.10",
    "@vitest/browser-playwright": "4.0.8",
    "playwright": "1.56.1",
    "prettier": "3.6.2",
    "typescript": "5.9.2",
    "vite": "7.0.6",
    "vitest": "4.0.8"
  }
}
